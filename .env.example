# OpenRouter API key (required for all AI generation)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Serper.dev API key (optional — without it, cards render without photos)
SERPER_API_KEY=your_serper_api_key_here

# Optional: override the OpenRouter model (defaults to deepseek/deepseek-v4-flash)
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
#
# Newer model — roughly 6x the cost of the default, similar speed on Decart:
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_PROVIDER_ORDER=Decart,Sail Research

# Optional: reasoning tokens are disabled by default for faster, more reliable JSON.
# Set to "on" to let the provider decide.
# OPENROUTER_REASONING=off

# Optional: pin preferred OpenRouter hosting providers (comma-separated, tried in
# order, automatic fallback). The same model can vary ~10x in price and ~3x in speed
# between providers, so pinning makes cost/latency predictable. Leave unset for
# OpenRouter's default routing.
# OPENROUTER_PROVIDER_ORDER=Decart,Sail Research
